{
  "_defaults": {
    "renderWidget": true,
    "sendSplunkAnalytics": true,
    "domainMap": {
      "acrobat": [
        "^(stage\\.)?acrobat\\.adobe\\.com$",
        "^.+--dc-frictionless--adobecom\\.aem\\.(page|live)$"
      ]
    },
    "directUploadVerbs": [],
    "directUploadMaxSize": 1048576,
    "experimentationOn": [],
    "optionDropdownPayloadKey": "option",
    "limits": {
      "maxNumFiles": 100,
      "allowedFileTypes": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.ms-powerpoint",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-excel",
        "text/plain",
        "text/rtf",
        "application/rtf",
        "text/vtt"
      ],
      "maxFileSize": 104857600,
      "max-char-limit": 3000,
      "pageLimit": { "maxNumPages": 600 }
    },
    "fetchApiConfig": {
      "finalizeAsset": {
        "retryType": "polling",
        "retryParams": {
          "maxRetryDelay": 300000,
          "defaultRetryDelay": 5000
        }
      },
      "getMetadata": {
        "retryType": "polling",
        "retryParams": {
          "maxRetryDelay": 5000,
          "defaultRetryDelay": 500
        }
      },
      "default": {
        "retryType": "exponential",
        "retryParams": {
          "maxRetries": 4,
          "retryDelay": 1000
        }
      }
    }
  },
  "prompt-upload-marquee": {
    "selector": ".foreground",
    "source": ".foreground .prompt-upload-container",
    "target": ".foreground .prompt-upload-container",
    "showSplashScreen": true,
    "splashScreenConfig": {
      "fragmentLink": "/dc-shared/fragments/shared-fragments/frictionless/splash-page/splashscreen",
      "splashScreenParent": "body"
    },
    "actionMap": {
      ".drop-zone": "upload",
      "#file-upload": "upload",
      ".gen-btn": "generate"
    }
  },
  "hero-marquee": {
    "selector": ".copy",
    "source": ".copy",
    "target": ".copy",
    "insert": "after",
    "showSplashScreen": true,
    "splashScreenConfig": {
      "fragmentLink": "/dc-shared/fragments/shared-fragments/frictionless/splash-page/splashscreen",
      "splashScreenParent": "body"
    },
    "actionMap": {
      ".drop-zone": "upload",
      "#file-upload": "upload",
      ".gen-btn": "generate"
    }
  },
  "unity-marquee": {
    "selector": ".unity-marquee-copy",
    "source": ".unity-marquee-copy",
    "target": ".unity-marquee-copy",
    "insert": "after",
    "showSplashScreen": true,
    "splashScreenConfig": {
      "fragmentLink": "/dc-shared/fragments/shared-fragments/frictionless/splash-page/splashscreen",
      "splashScreenParent": "body"
    },
    "actionMap": {
      ".drop-zone": "upload",
      "#file-upload": "upload",
      ".gen-btn": "generate"
    }
  },
  "verb-widget": {
    "renderWidget": false,
    "selector": ".verb-wrapper",
    "source": ".verb-wrapper .verb-container",
    "target": ".verb-wrapper .verb-container",
    "showSplashScreen": true,
    "splashScreenConfig": {
      "fragmentLink": "/dc-shared/fragments/shared-fragments/frictionless/splash-page/splashscreen",
      "splashScreenParent": "body"
    },
    "actionMap": {
      ".verb-wrapper": "upload",
      "#file-upload": "upload"
    }
  }
}
